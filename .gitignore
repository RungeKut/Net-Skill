# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- ДАННЫЕ ПЛОЩАДОК: только локально ---
# Здесь живут реальные адреса, SSID, логины, карты сетей, выгрузки
# конфигов и личные методички. Репозиторий публичный: попавшая в него
# схема сети — готовая карта для того, кто будет её ломать
# (knowledge/40_СРЕДА/40-03). Шаблоны — в templates/local/, они
# коммитятся; сама local/ — нет.
/local/

# --- стоп-лист: приметы площадок этой машины, только локально ---
# Лежащий в репозитории стоп-лист сам публиковал бы то, что должен
# скрывать (knowledge/40_СРЕДА/40-02). Заводится руками при установке.
tools/stoplist.txt

# --- выгрузки конфигов и дампы ---
# Конфиг роутера — не документация, а карта площадки.
*.rsc
*.backup
*.pcap
*.log

# --- пароли ---
# Никогда не под git, и на диске не дольше, чем нужно.
pw.txt
pw*.txt
*.psk

# --- прочее ---
*.bak
Thumbs.db
desktop.ini
.DS_Store
